#--------------------------------------------------------------------
# LuhurCamp Environment Configuration
# Copy this file to .env and fill in your values
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Application Settings
#--------------------------------------------------------------------
APP_NAME=LuhurCamp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

#--------------------------------------------------------------------
# Security
#--------------------------------------------------------------------
BCRYPT_ROUNDS=12

#--------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------
# Database Configuration
# ArenHost: Use mysql (recommended for better latency)
# Supabase: Use pgsql
#--------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# For Supabase (if using external PostgreSQL):
# DB_CONNECTION=pgsql
# DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your_password
# DB_SSLMODE=require

#--------------------------------------------------------------------
# Session & Cache
# For shared hosting: use 'database'
# For VPS with Redis: use 'redis'
#--------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

#--------------------------------------------------------------------
# Redis (Optional - for performance)
#--------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------
# Mail Configuration
#--------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------
# AWS (Optional - for S3 storage)
#--------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------
# Vite
#--------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------
# Third Party Services
#--------------------------------------------------------------------

# OpenWeather API (for weather widget)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

#--------------------------------------------------------------------
# Firebase Configuration
# Required for: Google Sign-In, Push Notifications (FCM)
#--------------------------------------------------------------------

# Option 1: File path (for local development)
# Place your firebase_credentials.json in storage/app/
FIREBASE_CREDENTIALS=storage/app/firebase_credentials.json

# Option 2: JSON string (for production/Railway/ArenHost)
# Paste the ENTIRE minified JSON content of your service account file
# Example: FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Firebase Auth Tenant (optional)
FIREBASE_AUTH_TENANT_ID=

# Firebase Realtime Database URL (optional)
FIREBASE_DATABASE_URL=

# Firebase Storage Bucket (optional)
FIREBASE_STORAGE_DEFAULT_BUCKET=

# Firebase Dynamic Links Domain (optional)
FIREBASE_DYNAMIC_LINKS_DEFAULT_DOMAIN=

#--------------------------------------------------------------------
# Production Checklist
#--------------------------------------------------------------------
# 1. Set APP_ENV=production
# 2. Set APP_DEBUG=false
# 3. Generate APP_KEY: php artisan key:generate
# 4. Set APP_URL to your production domain
# 5. Configure database credentials
# 6. Set FIREBASE_CREDENTIALS with minified JSON
# 7. (Optional) Set OPENWEATHER_API_KEY for weather feature
